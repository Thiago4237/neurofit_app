<DashboardScreen>:
    name: 'dashboard'

    MDNavigationLayout:

        ScreenManager:

            Screen:
                name: 'dashboard_content'

                MDBoxLayout:
                    orientation: 'vertical'

                    MDTopAppBar:
                        title: "NeuroFit"
                        elevation: 4
                        left_action_items: [["menu", lambda x: nav_drawer.set_state("open")]]

                    # =====================================================
                    # SELECTORES
                    # =====================================================

                    MDBoxLayout:
                        orientation: 'horizontal'
                        padding: 15
                        spacing: 15
                        size_hint_y: None
                        height: 120

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: 8

                            MDLabel:
                                text: "Objetivo"
                                halign: "center"
                                theme_text_color: "Secondary"

                            MDRaisedButton:
                                id: btn_objetivo
                                text: "Seleccionar objetivo"
                                on_release: app.abrir_selector_objetivo_dashboard()
                                size_hint_x: 1

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: 8

                            MDLabel:
                                text: "Estado de ánimo"
                                halign: "center"
                                theme_text_color: "Secondary"

                            MDRaisedButton:
                                id: btn_animo
                                text: "Seleccionar ánimo"
                                on_release: app.abrir_selector_animo()
                                size_hint_x: 1

                    # =====================================================
                    # NIVEL + INTENSIDAD (oculto hasta generar rutina)
                    # =====================================================

                    MDBoxLayout:
                        id: box_nivel_intensidad
                        orientation: "vertical"
                        spacing: 5
                        padding: [20, 0, 20, 0]
                        size_hint_y: None
                        height: 0
                        opacity: 0

                        MDLabel:
                            id: lbl_nivel
                            text: "Nivel: -"
                            halign: "center"
                            font_style: "H6"

                        MDLabel:
                            id: lbl_intensidad
                            text: "Intensidad: -"
                            halign: "center"
                            theme_text_color: "Secondary"

                    # =====================================================
                    # SCROLL RUTINAS
                    # =====================================================

                    MDScrollView:

                        MDGridLayout:
                            id: rutina_container
                            cols: 1
                            spacing: 15
                            padding: 20
                            adaptive_height: True

                            MDLabel:
                                id: rutina_placeholder
                                text: "Selecciona tu objetivo y ánimo,\nluego pulsa [b]Generar rutina[/b]"
                                halign: "center"
                                adaptive_height: True
                                theme_text_color: "Hint"
                                markup: True

                    # =====================================================
                    # BOTÓN GENERAR
                    # =====================================================

                    MDBoxLayout:
                        size_hint_y: None
                        height: 80
                        padding: 10

                        MDRaisedButton:
                            text: "Generar rutina"
                            size_hint_x: 0.8
                            pos_hint: {"center_x": .5}
                            on_release: app.generar_rutina()

        # =====================================================
        # MENU HAMBURGUESA
        # =====================================================

        MDNavigationDrawer:
            id: nav_drawer

            radius: (0, 16, 16, 0)
            md_bg_color: 1, 1, 1, 1
            scrim_color: 0, 0, 0, .35
            elevation: 4

            MDBoxLayout:
                orientation: "vertical"
                padding: 20
                spacing: 15
                adaptive_height: True
                pos_hint: {"top": 1}

                MDBoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: 120
                    spacing: 10

                    MDLabel:
                        text: "NeuroFit"
                        halign: "center"
                        font_style: "H6"

                MDSeparator:
                    height: "1dp"

                MDLabel:
                    text: "Perfil NeuroFit"
                    font_style: "Subtitle1"
                    bold: True
                    size_hint_y: None
                    height: self.texture_size[1]

                MDLabel:
                    id: drawer_info_label
                    text: "Cargando datos..."
                    markup: True
                    adaptive_height: True

                Widget:

                MDRectangleFlatButton:
                    text: "Editar datos básicos"
                    pos_hint: {"center_x": .5}
                    on_release: app.abrir_formulario_editar()

                MDRaisedButton:
                    text: "Eliminar información"
                    pos_hint: {"center_x": .5}
                    md_bg_color: 1, 0.2, 0.2, 1
                    on_release: app.eliminar_datos()