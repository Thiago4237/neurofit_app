<DashboardScreen>:
    name: 'dashboard'

    MDNavigationLayout:

        ScreenManager:

            Screen:
                name: 'dashboard_content'

                MDBoxLayout:
                    orientation: 'vertical'
                    md_bg_color: 0.95, 0.96, 0.97, 1

                    # ── TOP APP BAR ───────────────────────────────
                    MDTopAppBar:
                        title: "NeuroFit"
                        elevation: 2
                        md_bg_color: 0.18, 0.36, 0.43, 1
                        specific_text_color: 1, 1, 1, 1
                        left_action_items: [["menu", lambda x: nav_drawer.set_state("open")]]

                    # ── SELECTORES (tarjeta sobre fondo) ──────────
                    MDCard:
                        size_hint_y: None
                        height: dp(130)
                        radius: [0, 0, dp(20), dp(20)]
                        md_bg_color: 0.18, 0.36, 0.43, 1
                        elevation: 0
                        padding: [dp(16), dp(10), dp(16), dp(18)]

                        MDBoxLayout:
                            orientation: 'horizontal'
                            spacing: dp(12)

                            # Selector Objetivo
                            MDBoxLayout:
                                orientation: "vertical"
                                spacing: dp(6)

                                MDLabel:
                                    text: "Objetivo"
                                    halign: "center"
                                    font_style: "Caption"
                                    theme_text_color: "Custom"
                                    text_color: 0.78, 0.90, 0.93, 1
                                    size_hint_y: None
                                    height: dp(18)

                                MDCard:
                                    size_hint_y: None
                                    height: dp(48)
                                    radius: [dp(10)]
                                    md_bg_color: 0.24, 0.45, 0.54, 1
                                    elevation: 0
                                    on_release: app.abrir_selector_objetivo_dashboard()

                                    MDBoxLayout:
                                        padding: [dp(10), 0, dp(6), 0]

                                        MDLabel:
                                            id: btn_objetivo
                                            text: "Seleccionar"
                                            halign: "center"
                                            font_style: "Button"
                                            theme_text_color: "Custom"
                                            text_color: 1, 1, 1, 1

                                        MDIconButton:
                                            icon: "chevron-down"
                                            theme_text_color: "Custom"
                                            text_color: 0.78, 0.90, 0.93, 1
                                            size_hint_x: None
                                            width: dp(30)

                            # Selector Ánimo
                            MDBoxLayout:
                                orientation: "vertical"
                                spacing: dp(6)

                                MDLabel:
                                    text: "Estado de ánimo"
                                    halign: "center"
                                    font_style: "Caption"
                                    theme_text_color: "Custom"
                                    text_color: 0.78, 0.90, 0.93, 1
                                    size_hint_y: None
                                    height: dp(18)

                                MDCard:
                                    id: btn_animo_card
                                    size_hint_y: None
                                    height: dp(48)
                                    radius: [dp(10)]
                                    md_bg_color: 0.24, 0.45, 0.54, 1
                                    elevation: 0
                                    on_release: app.abrir_selector_animo()

                                    MDBoxLayout:
                                        padding: [dp(10), 0, dp(6), 0]

                                        MDLabel:
                                            id: btn_animo
                                            text: "Seleccionar"
                                            halign: "center"
                                            font_style: "Button"
                                            theme_text_color: "Custom"
                                            text_color: 1, 1, 1, 1

                                        MDIconButton:
                                            icon: "chevron-down"
                                            theme_text_color: "Custom"
                                            text_color: 0.78, 0.90, 0.93, 1
                                            size_hint_x: None
                                            width: dp(30)

                    # ── NIVEL + INTENSIDAD ────────────────────────
                    MDBoxLayout:
                        id: box_nivel_intensidad
                        orientation: "horizontal"
                        spacing: dp(0)
                        size_hint_y: None
                        height: 0
                        opacity: 0
                        padding: [dp(16), dp(8), dp(16), dp(4)]

                        MDCard:
                            radius: [dp(10)]
                            md_bg_color: 0.31, 0.80, 0.77, 0.18
                            elevation: 0
                            padding: [dp(12), dp(8)]

                            MDBoxLayout:
                                orientation: "horizontal"
                                spacing: dp(16)

                                MDLabel:
                                    id: lbl_nivel
                                    text: "Nivel: -"
                                    halign: "center"
                                    font_style: "Subtitle2"
                                    bold: True
                                    theme_text_color: "Custom"
                                    text_color: 0.18, 0.36, 0.43, 1

                                MDLabel:
                                    id: lbl_intensidad
                                    text: "Intensidad: -"
                                    halign: "center"
                                    font_style: "Caption"
                                    theme_text_color: "Custom"
                                    text_color: 0.35, 0.55, 0.60, 1

                    # ── SCROLL RUTINAS ────────────────────────────
                    MDScrollView:
                        do_scroll_x: False

                        MDGridLayout:
                            id: rutina_container
                            cols: 1
                            spacing: dp(12)
                            padding: [dp(16), dp(16), dp(16), dp(100)]
                            adaptive_height: True

                            MDLabel:
                                id: rutina_placeholder
                                text: "Selecciona tu objetivo y ánimo,\nluego pulsa [b]Generar rutina[/b]"
                                halign: "center"
                                adaptive_height: True
                                theme_text_color: "Hint"
                                markup: True
                                size_hint_y: None
                                height: dp(80)

                    # ── BOTÓN GENERAR (flotante abajo) ────────────
                    MDBoxLayout:
                        size_hint_y: None
                        height: dp(76)
                        padding: [dp(20), dp(12), dp(20), dp(12)]
                        md_bg_color: 0.95, 0.96, 0.97, 1

                        MDRaisedButton:
                            text: "GENERAR RUTINA"
                            md_bg_color: 0.18, 0.36, 0.43, 1
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(52)
                            font_size: '15sp'
                            on_release: app.generar_rutina()

        # ── NAVIGATION DRAWER ─────────────────────────────────────
        MDNavigationDrawer:
            id: nav_drawer
            radius: (0, dp(20), dp(20), 0)
            md_bg_color: 1, 1, 1, 1
            scrim_color: 0, 0, 0, 0.4
            elevation: 4

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(0)

                # Cabecera drawer
                MDBoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(140)
                    md_bg_color: 0.18, 0.36, 0.43, 1
                    padding: [dp(20), dp(28), dp(20), dp(20)]
                    spacing: dp(6)

                    MDLabel:
                        text: "NeuroFit"
                        font_style: "H5"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        size_hint_y: None
                        height: dp(44)

                    MDLabel:
                        text: "Tu perfil activo"
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: 0.78, 0.90, 0.93, 1
                        size_hint_y: None
                        height: dp(20)

                # Contenido drawer (scroll para pantallas pequeñas)
                MDScrollView:
                    do_scroll_x: False

                    MDBoxLayout:
                        orientation: "vertical"
                        padding: [dp(20), dp(20), dp(20), dp(20)]
                        spacing: dp(12)
                        adaptive_height: True

                        MDLabel:
                            text: "Perfil NeuroFit"
                            font_style: "Subtitle1"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.18, 0.36, 0.43, 1
                            size_hint_y: None
                            height: dp(28)

                        MDSeparator:
                            height: dp(1)

                        MDLabel:
                            id: drawer_info_label
                            text: "Cargando datos..."
                            markup: True
                            adaptive_height: True
                            theme_text_color: "Primary"
                            font_style: "Body2"

                        Widget:
                            size_hint_y: None
                            height: dp(20)

                        MDSeparator:
                            height: dp(1)

                        MDRectangleFlatButton:
                            text: "Editar datos básicos"
                            size_hint_x: 1
                            theme_text_color: "Custom"
                            text_color: 0.18, 0.36, 0.43, 1
                            line_color: 0.18, 0.36, 0.43, 1
                            size_hint_y: None
                            height: dp(48)
                            on_release: app.abrir_formulario_editar()

                        MDRaisedButton:
                            text: "Eliminar información"
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(48)
                            md_bg_color: 0.85, 0.15, 0.15, 1
                            on_release: app.eliminar_datos()
